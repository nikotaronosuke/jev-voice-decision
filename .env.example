# Copy to .env (untracked) or export in your shell. Values are intentionally empty.

# Required for Jev: API key from the TypeSafe Console.
TYPESAFE_API_KEY=
# Optional: model alias (SDK default is jev-latest).
# TYPESAFE_DEFAULT_MODEL=

# Voice Mode (optional). Local Parakeet JA via NVIDIA NeMo inside WSL. Leave empty to run Text Mode only.
# WSL path to the python of a venv that has nemo_toolkit[asr] + torch installed.
JVD_PARAKEET_WSL_PYTHON=
# WSL path to a folder holding exactly one Parakeet JA *.nemo checkpoint (plus optional provenance.json).
JVD_PARAKEET_MODEL_DIR=
# Optional: WSL path to a pre-extracted checkpoint folder (contains extraction.json); used read-only.
JVD_PARAKEET_EXTRACTED_DIR=
# Optional: WSL distro name (default Ubuntu) and precision (fp32 | fp16 | bf16).
# JVD_WSL_DISTRO=
# JVD_PARAKEET_PRECISION=
